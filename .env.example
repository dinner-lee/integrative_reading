# PostgreSQL (Neon이면 DATABASE_URL에 풀러(-pooler) 주소, DIRECT_URL에 -pooler를 뺀 직접 주소)
# Neon이 주는 주소의 &channel_binding=require 는 Prisma가 모르는 값이라 빼고 ?sslmode=require 만 둔다
DATABASE_URL="postgresql://user:password@localhost:5432/iwl_dev"
DIRECT_URL="postgresql://user:password@localhost:5432/iwl_dev"

# 쿠키 서명용 비밀값 (32자 이상, 무작위)
SESSION_SECRET="change-me-to-a-long-random-string-32chars+"

# 텍스트 마이닝 분석 서버 (analysis/)
ANALYSIS_URL="http://127.0.0.1:8000"
ANALYSIS_SECRET="change-me"

# Liveblocks (대시보드의 secret key)
LIVEBLOCKS_SECRET_KEY="sk_dev_..."
# 로컬 Liveblocks 개발 서버를 쓸 때만: http://127.0.0.1:1153 (키는 sk_localdev)
LIVEBLOCKS_BASE_URL=""
NEXT_PUBLIC_LIVEBLOCKS_BASE_URL=""

# 비워 두면 누구나 교사 가입 가능. 값을 넣으면 가입할 때 이 코드가 필요
TEACHER_SIGNUP_CODE=""
